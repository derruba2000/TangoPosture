# TangoPosture settings. Process environment overrides this file.

# Camera & view
tp_CAMERA=0
tp_WIDTH=640
tp_HEIGHT=480
tp_SIDE="left"
tp_FACING="right"
tp_CAPTURE_PROFILE="default"
tp_MIRROR=false
tp_ALLOW_ALL_ANGLES=false

# Files
tp_MODEL_PATH="models/pose_landmarker_lite.task"
tp_DATA_DIR="data"

# Quality & calibration
tp_CONFIDENCE=0.7
tp_MIN_TORSO=0.12
tp_MIN_HEAD=0.04
tp_MAX_VIEW_WIDTH=0.45
tp_VIEW_CHANGE_TOLERANCE=0.15
tp_CALIBRATION_DURATION=12
tp_CALIBRATION_VALID_DURATION=9
tp_CALIBRATION_SAMPLES=60
tp_OFFSET_MAD=0.03
tp_ANGLE_MAD=4

# Tracking
tp_SMOOTHING=0.25
tp_ENTRY_DURATION=1.5
tp_CLEAR_DURATION=0.75
tp_MAX_GAP=0.5
tp_HEAD_FORWARD_ENTRY=0.08
tp_HEAD_FORWARD_CLEAR=0.05
tp_HEAD_INCLINATION_ENTRY=10.0
tp_HEAD_INCLINATION_CLEAR=6.0
tp_TRUNK_INCLINATION_ENTRY=8.0
tp_TRUNK_INCLINATION_CLEAR=5.0

# Head & shoulders
tp_HEAD_NEUTRAL_OFFSET_DEGREES=-12.0
tp_HEAD_DOWN_DURATION_SECONDS=3.0
tp_HEAD_DOWN_ANGLE_DEGREES=-15.0
tp_SHOULDER_TENSION_DURATION_SECONDS=1.0
tp_SHOULDER_RAISE_THRESHOLD_PCT=10.0
tp_SHOULDER_NEUTRAL_CLEARANCE=1.05

# Embrace & knees
tp_ROLE_ASSIGN_MS=300.0
tp_ROLE_HOLD_MS=5000.0
tp_EMBRACE_CLOSED_THRESHOLD=0.72
tp_CLOSED_EMBRACE_MIN_KNEE_BEND_DEGREES=8.0
tp_KNEE_STRAIGHT_DURATION_SECONDS=1.0

# Torso & hip offset
tp_AXIS_CURVE_ENTRY=0.06
tp_AXIS_CURVE_CLEAR=0.035
tp_AXIS_CURVE_DURATION_SECONDS=1.5
tp_AXIS_CURVE_CLEAR_DURATION_SECONDS=0.75
tp_AXIS_NEUTRAL_OFFSET=0.0

# Music
tp_BEAT_TRACKING_ENABLED=true
tp_TANGO_BPM=120.0
tp_BEAT_ANALYSIS_SECONDS=30.0

# Review & Ollama
tp_REPLAY_AUDIO=false
tp_OLLAMA_BASE_URL="http://127.0.0.1:11434"
tp_OLLAMA_MODEL="llama3.2"
tp_OLLAMA_TIMEOUT=120.0
tp_OLLAMA_TEMPERATURE=0.2
tp_OLLAMA_NUM_CTX=16384
tp_OLLAMA_NUM_PREDICT=2048
tp_OLLAMA_MAX_REPORT_CHARS=40000
tp_OLLAMA_INSTRUCTION="Explain the supported observations and suggest three focused practice exercises."
